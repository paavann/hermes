# llm api keys and preffered model for timeline synthesis. primary and fallback.
LLM_API=llm_api_key
LLM_MODEL=llm_provider/llm_model_name
LLM_API_1=llm_api_key_1
LLM_MODEL_1=llm_provider_1/llm_model_name_1

# conversational chat (optional; the API serves 503 on /chat when disabled).
# kill switch: set to false for an immediate functional rollback.
CHAT_ENABLED=true

# answer model group. falls back to LLM_MODEL/LLM_API when left empty.
CHAT_MODEL=llm_provider/chat_model_name
CHAT_API=chat_api_key
# optional fallback for the answer model.
CHAT_MODEL_1=llm_provider_1/chat_model_name_1
CHAT_API_1=chat_api_key_1

# planner model group. falls back to the resolved chat model when left empty.
PLAN_MODEL=llm_provider/plan_model_name
PLAN_API=plan_api_key
# optional fallback for the planner model.
PLAN_MODEL_1=llm_provider_1/plan_model_name_1
PLAN_API_1=plan_api_key_1

# per-deployment requests-per-minute for the chat and plan router groups.
CHAT_RPM_LIMIT=60

# tavily web search (optional; when absent, chat runs without external search).
TAVILY_API_KEY=tvly-...

# request guards (in-memory, single-worker phase 1).
# per-IP sliding window: requests per window and window length in seconds.
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# daily token budget; set to 0 to disable.
CHAT_DAILY_TOKEN_BUDGET=500000
# concurrent streams allowed and how long a request may wait for a slot.
CHAT_MAX_CONCURRENT=4
CHAT_QUEUE_TIMEOUT_SECONDS=5
# trust X-Forwarded-For only when running behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# retrieval and answer limits.
CHAT_RETRIEVAL_TOP_K=8
CHAT_MIN_LOCAL_RESULTS=2
CHAT_MIN_SEMANTIC_SIMILARITY=0.2
CHAT_FRESHNESS_HOURS=24
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_HISTORY_TURNS=8
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_WEB_TIMEOUT_SECONDS=8
CHAT_STREAM_INCLUDE_USAGE=true

# langfuse tracing (optional — leave empty to disable).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Cloud regions: EU=https://cloud.langfuse.com  US=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
# redact prompt/answer/snippet content from traces. keep true in production.
LANGFUSE_MASK_CONTENT=true
