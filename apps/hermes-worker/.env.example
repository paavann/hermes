# llm api keys and preffered model. primary and fallback.
LLM_API=llm_api_key
LLM_MODEL=llm_provider/llm_model_name
LLM_API_1=llm_api_key_1
LLM_MODEL_1=llm_provider_1/llm_model_name_1

# embedding model api keys.
EMBED_API=embedding_api_key
EMBED_MODEL=embedding_provider/emebdding_model_name
EMBED_API_1=embedding_api_key_1
EMBED_MODEL_1=embedding_provider/emebdding_model_name_1

# langfuse tracing (optional — leave empty to disable).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Cloud regions: EU=https://cloud.langfuse.com  US=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
