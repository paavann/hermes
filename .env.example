# software environment.
ENV=production


# backend and frontend ports for container orchestration.
API_PORT=8000
FRONTEND_PORT=4200
DOCKER_DB_HOST=db-host

# database credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hermes
DB_USER=postgres
DB_PASSWORD=

# langfuse tracing (optional — leave empty to disable).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Cloud regions: EU=https://cloud.langfuse.com  US=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
