{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@hermes/source"],
    "baseUrl": ".",
    "paths": {
      "@hermes/util-types": ["./libs/shared/util-types/src/index.ts"],
      "@hermes/ui-components": ["./libs/shared/ui-components/src/index.ts"],
      "@hermes/feature-map": ["./libs/feature-map/src/index.ts"]
    }
  }
}
